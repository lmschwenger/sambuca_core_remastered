[flake8]
max-line-length = 100
exclude = 
    .git,
    __pycache__,
    .venv,
    .eggs,
    *.egg,
    build,
    dist,
    .pytest_cache
ignore = 
    E501,
    W503,
    E722,
    F401,
    E402,
    W293,
    W291,
    W292,
    F841,
    F541,
    E302,
    E261,
    E128,
    E226,
per-file-ignores =
    __init__.py:F401
    tests/*:F841,E501
    sambuca/gui/*:F841,W293,W291
